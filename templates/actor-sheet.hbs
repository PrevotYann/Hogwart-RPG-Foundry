<form class="flexcol hogwart-custom-sheet" autocomplete="off">
    <div class="header-container-wrapper">
        <div class="header-row">
            <div class="name-container">
                <div class="field-group">
                    <label class="label-custom">{{localize "HOGWART.Glowna.Name"}}</label>
                    <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize "HOGWART.Glowna.Nameo"}}" />
                </div>
                <div class="field-group" style="margin-top: 10px;">
                    <label class="label-custom">{{localize "HOGWART.Glowna.House"}}</label>
                    <select name="system.dom">
                        {{selectOptions system.domySelected selected=system.dom blank=""}}
                    </select>
                </div>
            </div>
            <div class="wyglad-container">
                <div class="wyglad-glowne-haslo">{{localize "HOGWART.Glowna.Wyglad"}}</div>
                <div class="wyglad-pola-row">
                    <div class="wyglad-segment">
                        <input type="text" name="system.cera" value="{{system.cera}}" placeholder="..." />
                        <label>{{localize "HOGWART.Glowna.Cera"}}</label>
                    </div>
                    <div class="wyglad-segment">
                        <input type="text" name="system.wlosy" value="{{system.wlosy}}" placeholder="..." />
                        <label>{{localize "HOGWART.Glowna.Wlosy"}}</label>
                    </div>
                    <div class="wyglad-segment">
                        <input type="text" name="system.budowa" value="{{system.budowa}}" placeholder="..." />
                        <label>{{localize "HOGWART.Glowna.Budowa"}}</label>
                    </div>
                </div>
            </div>
            <div class="wyglad-container">
                <div class="wyglad-glowne-haslo rozdzka-glowne-haslo">{{localize "HOGWART.Glowna.Rozdzka"}}</div>
                <div class="wyglad-pola-row">
                    <div class="wyglad-segment">
                        <input type="text" name="system.rozdzkaWyglad" value="{{system.rozdzkaWyglad}}" placeholder="..." />
                        <label>{{localize "HOGWART.Glowna.RWyglad"}}</label>
                    </div>
                    <div class="wyglad-segment">
                        <input type="text" name="system.rozdzkaRdzen" value="{{system.rozdzkaRdzen}}" placeholder="..." />
                        <label>{{localize "HOGWART.Glowna.Core"}}</label>
                    </div>
                    <div class="wyglad-segment">
                        <input type="text" name="system.rozdzkaDrewno" value="{{system.rozdzkaDrewno}}" placeholder="..." />
                        <label>{{localize "HOGWART.Glowna.Wood"}}</label>
                    </div>
                </div>
            </div>
            <div class="profile-img-container">
                <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
            </div>

        </div>
        <div class="sub-header-row">
            <div class="sub-row-segment">
                <select name="system.rokNauki">
                    {{selectOptions system.lataSelected selected=system.rokNauki}}
                </select>
                <label>{{localize "HOGWART.Glowna.Year"}}</label>
            </div>
            <div class="sub-row-segment">
                <select name="system.czystoscKrwi">
                    {{selectOptions system.krewSelected selected=system.czystoscKrwi}}
                </select>
                <label>{{localize "HOGWART.Glowna.Czystosc"}}</label>
            </div>
            <div class="sub-row-segment">
                <input type="text" name="system.ambicja" value="{{system.ambicja}}" placeholder="..." />
                <label>{{localize "HOGWART.Glowna.Ambicja"}}</label>
            </div>
            <div class="sub-row-segment">
                <input type="text" name="system.patronus" value="{{system.patronus}}" placeholder="..." />
                <label>{{localize "HOGWART.Glowna.Patronus"}}</label>
            </div>
        </div>
    </div>

    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="arkusz">
            <i class="fas fa-user-wizard"></i> {{localize "HOGWART.Tabs.Sheet"}}
        </a>
        <a class="item" data-tab="czary">
            <i class="fas fa-books"></i> {{localize "HOGWART.Tabs.Spells"}}
        </a>
        <a class="item" data-tab="historia">
            <i class="fas fa-scroll"></i> {{localize "HOGWART.Tabs.History"}}
        </a>
    </nav>
    <section class="sheet-body">
        <div class="tab active" data-group="primary" data-tab="arkusz">
            <div class="sheet-columns-grid">
                <div class="column-cechy">
                    <h2 class="sekcja-naglowek custom-banner">{{localize "HOGWART.Stats.Cechy"}}</h2>
                    <div class="hogwart-attributes-list">
                        <div class="cecha-row">
                            <label class="rollable" data-roll="2d6 + @cecha" data-cecha="odwaga"><i class="fas fa-dragon"></i>{{localize "HOGWART.Stats.Odwaga"}}</label>
                            <input type="number" name="system.odwaga" value="{{system.odwaga}}" />
                        </div>
                        <div class="cecha-row">
                            <label class="rollable" data-roll="2d6 + @cecha" data-cecha="spryt"><i class="fas fa-snake"></i>{{localize "HOGWART.Stats.Spryt"}}</label>
                            <input type="number" name="system.spryt" value="{{system.spryt}}" />
                        </div>
                        <div class="cecha-row">
                            <label class="rollable" data-roll="2d6 + @cecha" data-cecha="intelekt"><i class="fas fa-book"></i>{{localize "HOGWART.Stats.Intelekt"}}</label>
                            <input type="number" name="system.intelekt" value="{{system.intelekt}}" />
                        </div>
                        <div class="cecha-row">
                            <label class="rollable" data-roll="2d6 + @cecha" data-cecha="lojalnosc"><i class="fas fa-paw"></i>{{localize "HOGWART.Stats.Lojalnosc"}}</label>
                            <input type="number" name="system.lojalnosc" value="{{system.lojalnosc}}" />
                        </div>
                        <div class="cecha-row">
                            <label class="rollable" data-roll="2d6 + @cecha" data-cecha="magia"><i class="fas fa-wand-magic-sparkles"></i>{{localize "HOGWART.Stats.Magia"}}</label>
                            <input type="number" name="system.magia" value="{{system.magia}}" />
                        </div>
                    </div>
                    <div class="relacje-sekcja">
                        <h3 class="sekcja-naglowek relacje-naglowek">{{localize 'HOGWART.Przyjaciele.Przyjaciele_Rywale'}}</h3>

                        <div class="relacje-inputs">
                            <div class="relacja-row">
                                <i class="fas fa-heart relacja-icon przyjaciel-color"></i>
                                <input type="text" name="system.przyjaciel1" value="{{system.przyjaciel1}}" placeholder="{{localize 'HOGWART.Przyjaciele.Przyjaciel'}}" />
                            </div>
                            <div class="relacja-row">
                                <i class="fas fa-heart relacja-icon przyjaciel-color"></i>
                                <input type="text" name="system.przyjaciel2" value="{{system.przyjaciel2}}" placeholder="{{localize 'HOGWART.Przyjaciele.Przyjaciel'}}" />
                            </div>
                            <div class="relacja-row">
                                <i class="fas fa-heart-broken relacja-icon rywal-color"></i>
                                <input type="text" name="system.rywal" value="{{system.rywal}}" placeholder="{{localize 'HOGWART.Przyjaciele.Rywal'}}" />
                            </div>
                        </div>
                        <p class="relacje-opis">
                            {{localize 'HOGWART.Przyjaciele.Opis'}}
                        </p>
                    </div>
                    <div class="zwierzak-sekcja">
                        <div class="zwierzak-row-main">
                            <div class="zwierzak-badge">{{localize 'HOGWART.Przyjaciele.Zwierzak'}}</div>
                            <div class="zwierzak-inputs-container">
                                <div class="zwierzak-input-group">
                                    <input type="text" name="system.zwierzakGatunek" value="{{system.zwierzakGatunek}}" placeholder="{{localize 'HOGWART.Przyjaciele.Sowa'}}" />
                                    <label>{{localize 'HOGWART.Przyjaciele.Gatunek'}}</label>
                                </div>
                                <div class="zwierzak-input-group">
                                    <input type="text" name="system.zwierzakImie" value="{{system.zwierzakImie}}" placeholder="{{localize 'HOGWART.Przyjaciele.Przyklad'}}" />
                                    <label>{{localize 'HOGWART.Przyjaciele.Imie'}}</label>
                                </div>
                            </div>
                        </div>

                        <p class="zwierzak-opis">
                            {{localize 'HOGWART.Przyjaciele.ZwOpis'}}
                        </p>
                    </div>

                </div> 

                <div class="column-stany">
                    <h2 class="sekcja-naglowek custom-banner">{{localize 'HOGWART.Conditions.Stany'}}</h2>
                    <div class="stany-two-columns">
                        <div class="stany-sub-col">
                            <div class="stan-item">
                                <input type="checkbox" name="system.stanPrzestraszony" {{checked system.stanPrzestraszony}} />
                                <div class="stan-tekst"><strong>{{localize 'HOGWART.Conditions.Przestraszony'}}</strong> {{localize 'HOGWART.Conditions.PrzestraszonyOpis'}}</div>
                            </div>
                            <div class="stan-item">
                                <input type="checkbox" name="system.stanZly" {{checked system.stanZly}} />
                                <div class="stan-tekst"><strong>{{localize 'HOGWART.Conditions.Zly'}}</strong> {{localize 'HOGWART.Conditions.ZlyOpis'}}</div>
                            </div>
                            <div class="stan-item">
                                <input type="checkbox" name="system.stanZestresowany" {{checked system.stanZestresowany}} />
                                <div class="stan-tekst"><strong>{{localize 'HOGWART.Conditions.Zestresowany'}}</strong> {{localize 'HOGWART.Conditions.ZestresowanyOpis'}}</div>
                            </div>
                            <div class="stan-item">
                                <input type="checkbox" name="system.stanZazdrosny" {{checked system.stanZazdrosny}} />
                                <div class="stan-tekst"><strong>{{localize 'HOGWART.Conditions.Zazdrosny'}}</strong> {{localize 'HOGWART.Conditions.ZazdrosnyOpis'}}</div>
                            </div>
                            <div class="stan-item">
                                <input type="checkbox" name="system.stanZawstydzony" {{checked system.stanZawstydzony}} />
                                <div class="stan-tekst"><strong>{{localize 'HOGWART.Conditions.Zawstydzony'}}</strong> {{localize 'HOGWART.Conditions.ZawstydzonyOpis'}}</div>
                            </div>
                        </div>
                        <div class="stany-sub-col">
                            <div class="stan-item">
                                <input type="checkbox" name="system.stanRanny" {{checked system.stanRanny}} />
                                <div class="stan-tekst"><strong>{{localize 'HOGWART.Conditions.Ranny'}}</strong> {{localize 'HOGWART.Conditions.RannyOpis'}}</div>
                            </div>
                            <div class="stan-item" style="display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 8px;">
                                <label class="checkbox-label" style="display: flex; align-items: flex-start; gap: 6px; width: 100%;">
                                    <input type="checkbox" name="system.stanPrzeklety" {{checked system.stanPrzeklety}} style="margin-top: 2px;" />
                                    <span><strong>{{localize 'HOGWART.Conditions.Przeklety'}}</strong> <small style="color: #aaa;">{{localize 'HOGWART.Conditions.PrzekletyOpis'}}</small></span>
                                </label>
                                {{#if system.stanPrzeklety}}
                            <div style="margin-top: 6px; margin-left: 22px; width: calc(100% - 22px);">
                                <select name="system.przekletyCecha" class="select-przeklety" style="width: 100%;">
                                    {{#select system.przekletyCecha}}
                                    <option value="">{{localize 'HOGWART.Hexed.Tytul'}}</option>
                                    <option value="odwaga">{{localize 'HOGWART.Hexed.Odwaga'}}</option>
                                    <option value="spryt">{{localize 'HOGWART.Hexed.Spryt'}}</option>
                                    <option value="lojalnosc">{{localize 'HOGWART.Hexed.Lojalnosc'}}</option>
                                    <option value="intelekt">{{localize 'HOGWART.Hexed.Intelekt'}}</option>
                                    <option value="magia">{{localize 'HOGWART.Hexed.Magia'}}</option>
                                    {{/select}}
                                </select>
                            </div>
                                {{/if}}
                            </div>
                            <div class="stan-item">
                                <input type="checkbox" name="system.stanNieprzytomny" {{checked system.stanNieprzytomny}} />
                                <div class="stan-tekst"><strong>{{localize 'HOGWART.Conditions.Nieprzytomny'}}</strong> {{localize 'HOGWART.Conditions.NieprzytomnyOpis'}}</div>
                            </div>
                            <div class="stany-pomocniczy-opis">
                                {{localize 'HOGWART.Conditions.PomocniczyOpis'}}
                            </div>
                        </div>
                    </div>

                    <div class="stany-footer">
                        <p>{{{localize 'HOGWART.Conditions.FooterText'}}}</p>
                        <ul class="stany-wyniki-list">
                            <li>{{{localize 'HOGWART.Conditions.Result10'}}}</li>
                            <li>{{{localize 'HOGWART.Conditions.Result79'}}}</li>
                            <li>{{{localize 'HOGWART.Conditions.Result6'}}}</li>
                        </ul>
                        <button type="button" class="hg-opusc hg-przycisk {{#unless wszystkieStany}}hg-nieaktywny{{/unless}}">🎲 {{localize 'HOGWART.UI.ExitButton'}}</button>
                        <div class="blizna-container">
                            <label>{{localize 'HOGWART.Conditions.ScarLabel'}}</label>
                            <input type="text" name="system.stanBlizna" value="{{system.stanBlizna}}" placeholder="{{localize 'HOGWART.Conditions.ScarPlaceholder'}}" />
                        </div>
                    </div>
                <div class="ulubiony-przedmiot-sekcja">
                    <h2 class="sekcja-naglowek custom-banner">
                        <i class="fas fa-book-open" style="margin-right: 10px; font-size: 13px;"></i>
                        {{localize 'HOGWART.Conditions.FavPrzedmiot'}}
                        <i class="fas fa-book-open" style="margin-left: 10px; font-size: 13px;"></i>
                    </h2>
                    <div class="przedmioty-inputs">
                        <input type="text" name="system.ulubionyPrzedmiot1" value="{{system.ulubionyPrzedmiot1}}" placeholder="{{localize 'HOGWART.Conditions.Fav1'}}" />
                        <input type="text" name="system.ulubionyPrzedmiot2" value="{{system.ulubionyPrzedmiot2}}" placeholder="{{localize 'HOGWART.Conditions.Fav2'}}" />
                    </div>
                    <p class="przedmiot-opis">
                        {{localize 'HOGWART.Conditions.SubOpis'}}
                    </p>
                </div>
            </div>

                <div class="column-zasoby">
                    <div class="zasob-sekcja">
                        <h2 class="sekcja-naglowek custom-banner">{{localize 'HOGWART.PD.Szczescie'}}</h2>
                        <div class="stars-row">
                            <label class="checkbox-star"><input type="checkbox" name="system.szczescie1" {{checked system.szczescie1}} /><span></span></label>
                            <label class="checkbox-star"><input type="checkbox" name="system.szczescie2" {{checked system.szczescie2}} /><span></span></label>
                            <label class="checkbox-star"><input type="checkbox" name="system.szczescie3" {{checked system.szczescie3}} /><span></span></label>
                        </div>
                        <p class="zasob-opis">{{localize 'HOGWART.PD.LuckOpis'}}</p>
                    </div>
                    <div class="zasob-sekcja">
                        <h2 class="sekcja-naglowek custom-banner">{{localize 'HOGWART.PD.EXP'}}</h2>
                        <div class="diamonds-row">
                            <label class="checkbox-diamond"><input type="checkbox" name="system.pd1" {{checked system.pd1}} /><span></span></label>
                            <label class="checkbox-diamond"><input type="checkbox" name="system.pd2" {{checked system.pd2}} /><span></span></label>
                            <label class="checkbox-diamond"><input type="checkbox" name="system.pd3" {{checked system.pd3}} /><span></span></label>
                            <label class="checkbox-diamond"><input type="checkbox" name="system.pd4" {{checked system.pd4}} /><span></span></label>
                        </div>
                        <p class="zasob-opis">{{localize 'HOGWART.PD.ExpOpis'}}</p>
                    </div>
                    <div class="zasob-sekcja awans-box">
                        <h2 class="sekcja-naglowek custom-banner">{{localize 'HOGWART.PD.Awans'}}</h2>
                        <p class="zasob-opis" style="margin-bottom: 10px;">{{localize 'HOGWART.PD.AwansOpis'}}</p>

                        <div class="awans-list">
                            <div class="awans-dwukrotny">
                                <input type="checkbox" name="system.awansCechy1" {{checked system.awansCechy1}} />
                                <input type="checkbox" name="system.awansCechy2" {{checked system.awansCechy2}} />
                                <span class="awans-etykieta">{{localize 'HOGWART.PD.ZwiekszCeche'}}</span>
                            </div>
                            <label class="awans-item">
                                <input type="checkbox" name="system.awansPrzedmiot" {{checked system.awansPrzedmiot}} />
                                {{localize 'HOGWART.PD.UlubionyPrzedmiot'}}
                            </label>
                            <label class="awans-item">
                                <i class="fas fa-infinity"></i> {{localize 'HOGWART.PD.NoweZaklecie'}}
                            </label>
                            <label class="awans-item">
                                <i class="fas fa-infinity"></i> {{localize 'HOGWART.PD.MagicznyPrzedmiot'}}
                            </label>
                            <label class="awans-item">
                                <i class="fas fa-infinity"></i> {{localize 'HOGWART.PD.OdzyskajSzczescie'}}
                            </label>
                        </div>
                    </div>
                    <div class="magiczne-obiekty-sekcja">
                        <h2 class="sekcja-naglowek custom-banner">
                            <i class="fas fa-crystal-ball" style="margin-right: 8px; font-size: 13px;"></i>
                            {{localize 'HOGWART.EQ.EqTitle'}}
                            <i class="fas fa-crystal-ball" style="margin-left: 8px; font-size: 13px;"></i>
                        </h2>

                        <div class="obiekty-grid">
                            <div class="obiekty-kolumna">
                                <input type="text" name="system.obiekt1" value="{{system.obiekt1}}" placeholder="..." />
                                <input type="text" name="system.obiekt2" value="{{system.obiekt2}}" placeholder="..." />
                                <input type="text" name="system.obiekt3" value="{{system.obiekt3}}" placeholder="..." />
                                <input type="text" name="system.obiekt4" value="{{system.obiekt4}}" placeholder="..." />
                            </div>
                            <div class="obiekty-kolumna">
                                <input type="text" name="system.obiekt5" value="{{system.obiekt5}}" placeholder="..." />
                                <input type="text" name="system.obiekt6" value="{{system.obiekt6}}" placeholder="..." />
                                <input type="text" name="system.obiekt7" value="{{system.obiekt7}}" placeholder="..." />
                                <input type="text" name="system.obiekt8" value="{{system.obiekt8}}" placeholder="..." />
                            </div>
                        </div>
                        <ol class="hg-lista-przedmiotow">
                            {{#each przedmioty as |item|}}
                            <li class="item" data-item-id="{{item._id}}">
                                <img src="{{item.img}}" width="24" height="24" />
                                <a class="item-use" title="{{localize 'HOGWART.UI.Use'}}">{{item.name}}</a>
                                <a class="item-edit" title="{{localize 'HOGWART.UI.Edit'}}"><i class="fas fa-edit"></i></a>
                                <a class="item-delete" title="{{localize 'HOGWART.UI.Delete'}}"><i class="fas fa-trash"></i></a>
                            </li>
                            {{/each}}
                        </ol>
                        <div class="hg-przedmioty-stopka">
                            <small>{{localize 'HOGWART.UI.ItemsHelp'}}</small>
                            <a class="item-create" data-type="przedmiot" title="{{localize 'HOGWART.UI.NewItem'}}"><i class="fas fa-plus"></i></a>
                        </div>
                    </div>
                    <div class="hg-quidditch-sekcja">
                        <h2 class="sekcja-naglowek custom-banner">🧹 {{localize 'HOGWART.Quidditch.Title'}}</h2>
                        <button type="button" class="hg-quidditch hg-przycisk" data-ruch="mecz-quidditcha">{{localize 'MOVES.mecz-quidditcha.name'}}</button>
                        <button type="button" class="hg-quidditch hg-przycisk" data-ruch="zloty-znicz">{{localize 'MOVES.zloty-znicz.name'}}</button>
                    </div>
                </div>
            </div>
        </div>



        <div class="tab" data-group="primary" data-tab="czary">
            <div class="czary-kontener">
                <div class="kolumna-zaklecia">
                    <p class="hg-zaklecia-pomoc">{{localize 'HOGWART.UI.SpellsHelp'}}</p>
                    {{#each kartaZaklec.lata as |rok|}}
                    <div class="rok-sekcja">
                        <div class="rok-naglowek">{{rok.tytul}}</div>
                        <ul class="lista-zaklec">
                            {{#each rok.zaklecia as |z|}}
                            <li>
                                <input type="checkbox" name="system.zaklecia.{{z.id}}" {{checked z.znane}} />
                                <i class="fas {{z.ikona}} {{z.klasa}}" title="{{z.etykieta}}"></i>
                                <a class="nazwa-zaklecia hg-zaklecie-rzut" data-zaklecie="{{z.id}}">{{z.nazwa}}</a>{{#if z.opis}} — <span class="opis-zaklecia">{{z.opis}}</span>{{/if}}
                            </li>
                            {{/each}}
                        </ul>
                    </div>
                    {{/each}}
                </div>
                <div class="kolumna-legenda">
                    <div class="legenda-sekcja">
                        <div class="legenda-naglowek">{{localize 'HOGWART.Legend.LegendaTyt'}}</div>
                        <div class="legenda-siatka">
                            <div class="legenda-item"><i class="fas fa-star-of-life ikona-urok"></i> {{localize 'HOGWART.Legend.Uroki'}}</div>
                            <div class="legenda-item"><i class="fas fa-heart ikona-leczenie"></i> {{localize 'HOGWART.Legend.Leczenie'}}</div>
                            <div class="legenda-item"><i class="fas fa-bolt ikona-klatwa"></i> {{localize 'HOGWART.Legend.Curse'}}</div>
                            <div class="legenda-item"><i class="fas fa-bahai ikona-zly-urok"></i> {{localize 'HOGWART.Legend.BadUroki'}}</div>
                            <div class="legenda-item"><i class="fas fa-shield-alt ikona-obrona"></i> {{localize 'HOGWART.Legend.Obrona'}}</div>
                            <div class="legenda-item"><i class="fas fa-flask ikona-eliksir"></i> {{localize 'HOGWART.Legend.Eliksiry'}}</div>
                            <div class="legenda-item"><i class="fas fa-wine-glass ikona-transmutacja"></i> {{localize 'HOGWART.Legend.Transmutacja'}}</div>
                            <div></div>
                            <div class="legenda-item cala-szerokosc"><i class="fas fa-skull ikona-niewybaczalne"></i>{{localize 'HOGWART.Legend.Niewybaczalne'}}</div>
                        </div>
                        <div class="legenda-przypisy">
                            <p><strong>*</strong> {{localize 'HOGWART.Legend.Patronus'}}</p>
                            <p><strong>**</strong> {{localize 'HOGWART.Legend.Aportacja'}}</p>
                            <p><strong>***</strong> {{localize 'HOGWART.Legend.Portus'}}</p>
                        </div>
                    </div>
                    <div class="rok-sekcja" style="margin-top: 20px;">
                        <div class="rok-naglowek">{{localize 'HOGWART.Legend.Stany'}}</div>
                        <div class="opis-zasad" style="padding: 10px; font-size: 13px; line-height: 1.5; color: #aaa; ">
                            <p style="margin-bottom: 10px;">
                                {{{localize 'HOGWART.Legend.Stany2'}}}
                            </p>
                            <p style="margin-bottom: 10px;">
                                {{{localize 'HOGWART.Legend.Obronne'}}}
